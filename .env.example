# Copy to .env and fill in real values.

# GitHub Personal Access Token with at minimum:
#   - repo (or fine-grained: contents:read, actions:read, issues:write)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq API key -- free tier, get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

LLM_MODEL=llama-3.3-70b-versatile

DATABASE_URL=sqlite:///./investigator.db

# Note: the target repo (owner/name) is passed as a CLI argument or
# API parameter at investigation time, not configured here -- this
# lets the same installation investigate any repo without code changes.
